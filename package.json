{
  "name": "seth-haynes-photography",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "publish": "node scripts/publisher/publish.mjs",
    "publish:rebuild": "node scripts/publisher/publish.mjs --rebuild",
    "publish:prune": "node scripts/publisher/prune.mjs",
    "publish:prune:apply": "node scripts/publisher/prune.mjs --apply",
    "publisher:start": "node scripts/publisher/start-background.mjs",
    "publisher:startup:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publisher/install-startup.ps1",
    "publisher:startup:remove": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/publisher/install-startup.ps1 -Remove",
    "watch": "node scripts/publisher/watch.mjs",
    "test": "pnpm run test:site && pnpm run test:publisher",
    "test:site": "node scripts/build.mjs && node tests/build.test.mjs",
    "test:publisher": "node tests/publisher-config.test.mjs && node tests/publisher-manifest.test.mjs && node tests/publisher-images.test.mjs && node tests/publisher-metadata.test.mjs && node tests/publisher-watch.test.mjs && node tests/publisher-prune.test.mjs && node tests/publisher-startup.test.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "exifr": "^7.1.3",
    "sharp": "^0.35.3"
  }
}
